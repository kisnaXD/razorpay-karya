# Local development (Docker Mongo + pnpm dev)
MONGO_URL=mongodb://127.0.0.1:27017/karya
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
ORG_ID=org_arka
NODE_ENV=development

# Frontend API base URL — unset defaults to http://localhost:4000 (CORS).
# Set to empty string in Docker/Caddy builds for same-origin /v1 paths.
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Razorpay test mode (rzp_test_*) — required for Payment Links / webhooks demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional — enables RazorpayXProvider instead of LedgerPayoutProvider
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
PAYOUT_PROVIDER=ledger

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional — send drafted emails via Resend when approving email.send
RESEND_API_KEY=
RESEND_FROM=
# Optional — polish calendar/listing/email copy with LLM (off in CI)
LLM_COPY_ENABLED=false
# Merchant org exposed via public /a2a/* (single-tenant MVP)
A2A_ORG_ID=org_arka
# Optional — Playwright allowlisted browser for sourcing (falls back to seeded directory)
BROWSER_ENABLED=false

# Dev-only: POST /v1/admin/simulate-webhook forces payment_link.expired / payment.failed
# for the Track 01 Money agent demo (NODE_ENV=development required)
# POST /v1/admin/seed is disabled when NODE_ENV=production — use scripts/deploy/seed-production.ts

# --- Production notes (see .env.production.example) ---
# PUBLIC_URL / WEB_ORIGIN = public origin (CORS), e.g. https://karya-demo.example.com
# CADDY_SITE = hostname for TLS, or :80 for HTTP on Elastic IP
# Atlas MONGO_URL; network allowlist EC2 Elastic IP /32 only
# Razorpay webhook URL: https://<host>/v1/webhooks/razorpay
# Tear-down: stop EC2, revoke Atlas IP, rotate test keys
