# =============================================================================
# Karya production environment template
# Copy to .env.production on EC2 (never commit secrets).
# =============================================================================

# --- Deployment mode A: EC2 + Docker Compose + Caddy (single host) -----------
# PUBLIC_URL = browser-facing origin (CORS + links). Same host serves web + API.
PUBLIC_URL=https://karya-demo.example.com
WEB_ORIGIN=https://karya-demo.example.com
CADDY_SITE=karya-demo.example.com
# Frontend build inside Docker: leave NEXT_PUBLIC_API_URL empty for same-origin /v1
NEXT_PUBLIC_API_URL=

# --- Deployment mode B: Vercel (frontend) + EC2 (API only) -------------------
# Set on Vercel project settings:
#   NEXT_PUBLIC_API_URL=https://api.karya-demo.example.com
# Set on EC2 API (.env.production):
#   WEB_ORIGIN=https://your-app.vercel.app
#   (comma-separate preview URLs: WEB_ORIGIN=https://app.vercel.app,https://app-*.vercel.app)
# PUBLIC_URL on API host = API public URL (for webhooks / A2A links if needed)
# PUBLIC_URL=https://api.karya-demo.example.com
# CADDY_SITE=:80
# NEXT_PUBLIC_API_URL is not used on EC2 when web runs on Vercel

# --- Database (MongoDB Atlas recommended for EC2) ------------------------------
MONGO_URL=mongodb+srv://karya_app:***@cluster.mongodb.net/karya
NODE_ENV=production
API_PORT=4000
ORG_ID=org_arka
A2A_ORG_ID=org_arka

# --- Razorpay (test mode for demo) ---------------------------------------------
RAZORPAY_KEY_ID=rzp_test_***
RAZORPAY_KEY_SECRET=***
RAZORPAY_WEBHOOK_SECRET=***
# Dashboard webhook URL: https://<PUBLIC_URL>/v1/webhooks/razorpay

# --- LLM (Governor agent) ------------------------------------------------------
OPENAI_API_KEY=sk-***
OPENAI_MODEL=gpt-4o-mini

# --- Optional integrations -----------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=
LLM_COPY_ENABLED=false
BROWSER_ENABLED=false
PAYOUT_PROVIDER=ledger
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=

# --- Agent scheduler (set false to disable background exception scans) ---------
# AGENT_EVENTS_ENABLED=false

# --- IP-only demo (no DNS) -----------------------------------------------------
# PUBLIC_URL=http://<elastic-ip>
# WEB_ORIGIN=http://<elastic-ip>
# CADDY_SITE=:80
