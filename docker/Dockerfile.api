# Karya API — multi-stage Node 22 Alpine
# Packages export TypeScript source; runtime uses tsx (same as local `pnpm dev`).
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/a2a/package.json ./packages/a2a/
COPY packages/agents/package.json ./packages/agents/
COPY packages/graph/package.json ./packages/graph/
COPY packages/policy/package.json ./packages/policy/
COPY packages/razorpay/package.json ./packages/razorpay/
COPY packages/seed/package.json ./packages/seed/
COPY packages/tokens/package.json ./packages/tokens/
# Web package.json present so the workspace resolves; not installed for API image
COPY apps/web/package.json ./apps/web/
RUN pnpm install --frozen-lockfile --filter @karya/api...

FROM base AS runner
RUN apk add --no-cache wget
ENV NODE_ENV=production
ENV API_PORT=4000
COPY --from=deps /app /app
COPY apps/api ./apps/api
COPY packages/a2a ./packages/a2a
COPY packages/agents ./packages/agents
COPY packages/graph ./packages/graph
COPY packages/policy ./packages/policy
COPY packages/razorpay ./packages/razorpay
COPY packages/seed ./packages/seed
COPY packages/tokens ./packages/tokens
COPY tsconfig.base.json ./

WORKDIR /app/apps/api
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:4000/health || exit 1
CMD ["pnpm", "exec", "tsx", "src/index.ts"]
