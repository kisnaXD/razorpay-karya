# Karya Web — Next.js standalone output
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json ./apps/web/
COPY apps/api/package.json ./apps/api/
COPY packages/a2a/package.json ./packages/a2a/
COPY packages/agents/package.json ./packages/agents/
COPY packages/graph/package.json ./packages/graph/
COPY packages/policy/package.json ./packages/policy/
COPY packages/razorpay/package.json ./packages/razorpay/
COPY packages/seed/package.json ./packages/seed/
COPY packages/tokens/package.json ./packages/tokens/
RUN pnpm install --frozen-lockfile --filter @karya/web...

FROM base AS builder
COPY --from=deps /app /app
COPY apps/web ./apps/web
COPY packages/tokens ./packages/tokens
COPY tsconfig.base.json ./
# Same-origin /v1 and /a2a via Caddy — no public API host at build time
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_API_URL=
RUN pnpm --filter @karya/web build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
# public/ is optional; create empty dir so COPY never fails if missing
RUN mkdir -p ./apps/web/public
COPY --from=builder /app/apps/web/public ./apps/web/public

EXPOSE 3000
CMD ["node", "apps/web/server.js"]
